//Skills
//Dune Sovereign Helm
if (var level >= 12, hasItem slot_1 Metadata Armor "Any Amount", var asvar14 = 0 0) {
    var asvar14 = 30
} 
if (var asvar14 >= 25) {
    var str += 8
}
//Tremor Walker's Legguards
if (var level >= 12, hasItem slot_2 Metadata Armor "Any Amount", inRegion "Desert/Cave") {
    var agility += 1
}
//Earthshaker's Carapace
if (var level >= 12, hasItem slot_5 Metadata Armor "Any Amount", var hpper <= 30) {
    var def += 8
} 
//Terraquake Devastator
if (var level >= 12, hasItem slot_6 Metadata Hand "Any Amount", var asvar15 = 0 0) {
    var skilldmg = var dmg
    var skilldmg *= 3
    var skilldmg /= 2
    var mobhp -= var skilldmg
    var asvar15 = 5
}





goto function "Attack Skill 2"
    if (var level >= 12, hasItem slot_1 Metadata Armor "Any Amount", var asvar14 = 0 0) {
