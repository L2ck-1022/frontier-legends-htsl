goto function "Item Stats 5 (Snowfield)"
if (var level >= 12, hasItem slot_1 Metadata Armor "Any Amount") {
    var maxhp += 20
    var def += 18
    var hpr += 2
} 
if (var level >= 12, hasItem slot_2 Metadata Armor "Any Amount") {
    var maxhp += 18
    var def += 12
    var hpr += 1
}
