goto function "Merchant 6 (Desert, Foraging)"
    if (hasItem slot_1 Metadata Hand "Equal or Greater Amount") {
        removeItem slot_1 true
        var gold += 640
        chat "&aYou sold &fOak Log &8x64 &afor &6640 Gold&a!"
        exit   
    } 
    if (hasItem slot_2 Metadata Hand "Equal or Greater Amount") {
        removeItem slot_2 true
        var gold += 160
        chat "&aYou sold &fOak Log &8x16 &afor &6160 Gold&a!"
        exit   
    } 
    if (hasItem slot_3 Metadata Hand "Equal or Greater Amount") {
        removeItem slot_3 true
        var gold += 40
        chat "&aYou sold &fOak Log &8x4 &afor &640 Gold&a!"
        exit   
    } 
    if (hasItem slot_4 Metadata Hand "Equal or Greater Amount") {
        removeItem slot_4 true
        var gold += 10
        chat "&aYou sold &fOak Log &8x1 &afor &610 Gold&a!"
        exit   
    }

