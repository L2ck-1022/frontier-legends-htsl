goto function "Accessories Stats 1"
    if (var accvar8 = 2) {
        var acceff += 5
        var accmaxmana += 10
    }
    if (var accvar9 = 2) {
        var accwoodmf += 5
        var accmaxhp += 5
    }
//ceff...current eff, beff...block eff
goto function "Mine Event"
    if (var blockid >= 100, !var tpower >= %var.player/blockhardly%) {
        chat "&7[&c!&7] &cYou cannot break the block due to a lack of &2&lTimber Power&c!"
    }
    if (var blockid < 100, !var blockid = %var.player/prevblockid% 0) {
        var prevblockid = %var.player/blockid%
        var ceff = 0
    } 
    var ceff += %var.player/eff%
    var effper = %var.player/ceff%
    var effper *= 100
    var effper /= %var.player/beff%
    if (var ceff >= %var.player/beff%) {
        title "&a&lMINED!" "&8( &7&l%var.player/beff% &8/ %var.player/beff% )" 0 1 1
        sound "Orb Pickup" 0.7 1.0 "Invokers Location"
        var ceff = 0
        var clogs += 1
    } else {
        title "&a&l%var.player/effper%%" "&8( &7&l%var.player/ceff% &8/ %var.player/beff% )" 0 1 1
        exit
    }
    if (var blockid = 1) {
        giveItem slot_29 true
    }
    var minedropchance = 10
    var minedropchance *= %var.player/woodmf%
    if (var blockid < 100, placeholder %random.int/1 10001% <= %var.player/minedropchance%) {
        giveItem slot_30 true
        chat "&7[&a!&7] You found a &aCedar Log&7!"
        sound "Item Pickup" 0.7 1.0 "Invokers Location"
    }
    var minedropchance = 2
    var minedropchance *= %var.player/woodmf%
    if (var blockid < 100, placeholder %random.int/1 10001% <= %var.player/minedropchance%) {
        giveItem slot_31 true
        chat "&7[&a!&7] You found a &9Mahogany Log&7!"
        sound "Item Pickup" 0.7 1.0 "Invokers Location"
    }
goto event "Player Block Break"
    if (blockType slot_28 true) {
        var blockid = 1
        var blockhardly = 1
        var beff = 100
        var minetime = 20
        function "Mine Event"
    }
goto function "Mine End"
    if (var minetime >= 1 0) {
        var minetime -= 1
        var cminetime += 5D
    }
    if (var minetime = 12) {
        sound "Note Snare Drum" 0.7 1.0 "Invokers Location"
        title "&a●&a &a &a &7●&a &a &a &7●" "&a" 0 1 1
    }
    if (var minetime = 8) {
        sound "Note Snare Drum" 0.7 1.0 "Invokers Location"
        title "&a●&a &a &a &a●&a &a &a &7●" "&a" 0 1 1
    }
    if (var minetime = 4) {
        sound "Note Snare Drum" 0.7 1.0 "Invokers Location"
        title "&a●&a &a &a &a●&a &a &a &a●" "&a" 0 1 1
    }
    if (var minetime = 0, var blockid < 100) {
        var cminetime /= 20D
        chat "&7[&a!&7] &7Mined &a&l%var.player/clogs%✎ Logs &7in &6%var.player/cminetime%s&7!"
        sound "Orb Pickup" 0.7 1.0 "Invokers Location"
        var clogs unset
        var blockid unset
        var minetime unset
        var cminetime unset
        var effper unset
        var beff unset
        var minedropchance unset
        var blockhardly unset
    }
goto function "Loop"
    function "Mine End"