//Cost enter
if (globalvar gmob1/ongoing = 1 0) {
    chat "&7[&c!&7] &c&lERROR! &cThe boss is spawned already!"
    sound "Anvil Land" 0.7 1.0 "Invokers Location"
    exit
}
if (var gem >= 25) {
    var gem -= 25
    globalvar gmob1_spawner = %player.name%
    globalvar gmob1/ongoing = 1
    globalvar gmobhp1 = 200000
    globalvar gmob1_event = %random.int/1 3%
    globalvar gannounce = 1
    function "Globalboss Announce" true
} else {
    chat "&c✗ Not met the Requirements!"
    sound "Anvil Land" 0.7 1.0 "Invokers Location"
    exit
}

goto function "Globalboss Announce" 
    if (globalvar gannounce = 1) {
        sound "Enderdragon Growl" 0.7 1.0 "Invokers Location"
        chat "&4&m&l----------------------------------------"
        chat "&4&l[Global Boss] &8The sands begin to stir..."
        chat "&e&lSandworm &8( &c&l100k❤ &8) &7has been summoned by &a%var.global/gmob1/spawner%&7!"
        chat "&7Use &a/sandworm &7to teleport the battle place."
        chat "&4&m&l----------------------------------------"
    }
    if (globalvar gannounce = 2, var mobid = 101) {
        tp "custom_coordinates" "22.5 3 -81.5 140 25"
        chat "&4&m&l-----------------------------------"
        chat "&4&l[Global Boss] &6&lSandworm &7has beaten!"
        chat "&a"
        chat "&7 &7 &7&m&l--------&r&7&l Top Players &7&m&l--------"
        chat "&7 &7 &7 &7 &7 &7 &7 &7 &4&l#1 &a%var.global/gmob_top1% &7&l| &c%var.global/gmob_top1_dmg%⚔"
        chat "&7 &7 &7 &7 &7 &7 &7 &7 &4#2 &a%var.global/gmob_top2% &7&l| &c%var.global/gmob_top2_dmg%⚔"
        chat "&7 &7 &7 &7 &7 &7 &7 &7 &4#3 &a%var.global/gmob_top3% &7&l| &c%var.global/gmob_top3_dmg%⚔"
        chat "&4&m&l-----------------------------------"
        var droptimes += 1
        pause 5
        globalvar gmob_top1 unset
        globalvar gdmg_top1 unset
        globalvar gmob_top2 unset
        globalvar gdmg_top2 unset
        globalvar gmob_top3 unset
        globalvar gdmg_top3 unset
    }
goto region "Sandworm Enter" "Enter Action"
    if (globalvar gmob1/ongoing = 1 0) {
        tp "custom_coordinates" "59.5 90 -95.5 -45 15" 
    } else {
        chat "&7[&c!&7] &c&lERROR! &cThe boss isn't spawned yet!"
        sound "Anvil Land" 0.7 1.0 "Invokers Location"
        changeVelocity 10 5 -10
    }
goto command "sandworm"
    if (globalvar gmob1/ongoing = 1 0) {
        tp "custom_coordinates" "59.5 90 -95.5 -45 15" 
    } else {
        chat "&7[&c!&7] &c&lERROR! &cThe boss isn't spawned yet!"
        sound "Anvil Land" 0.7 1.0 "Invokers Location"
    }

goto function "Global Mob Data"
    if (var mobid = 101) {
        globalvar gmobhp1 -= var damage
        var gmobdmg1 += var damage
        var mobhp = globalvar gmobhp1
        var maxmobhp = 200000
    }

goto function "Global Mob Kill Detect"
    if (var mobid = 101, var gmobhp1 <= 0) {
        globalvar gannounce = 2
        function "Globalboss Ranking" true
        pause 5
        function "Globalboss Announce" true
        pause 5
        globalvar gmob1_p unset
        globalvar gmobhp1 unset
        globalvar gmobhp1_p1 unset
        globalvar gmobhp1_p2 unset
        globalvar gmobhp1_p3 unset
    }
goto function "Globalboss Ranking"
    if (var mobid = 101) {
        var gdmg = var gmobdmg1
        pause 5
        var gmobdmg1 unset
    }
    if (var gdmg >= globalvar gdmg_top1 0) {
        globalvar gmob_top3 = globalvar gmob_top2
        globalvar gdmg_top3 = globalvar gdmg_top2
        globalvar gmob_top2 = globalvar gmob_top1
        globalvar gdmg_top2 = globalvar gdmg_top1
        globalvar gmob_top1 = %player.name%
        globalvar gdmg_top1 = var gdmg
        exit
    }
    if (var gdmg >= globalvar gdmg_top2 0) {
        globalvar gmob_top3 = globalvar gmob_top2
        globalvar gdmg_top3 = globalvar gdmg_top2
        globalvar gmob_top2 = %player.name%
        globalvar gdmg_top2 = var gdmg
        exit
    }
    if (var gdmg >= globalvar gdmg_top3 0) {
        globalvar gmob_top3 = %player.name%
        globalvar gdmg_top3 = var gdmg
    }
goto function "Global Mob Ability"
    var gmob_ab_arg = %random.decimal/0.0 1.57%
        var gmob_ab_sin = var gmob_ab_arg
        var gmob_ab_sin *= var gmob_ab_arg
        var gmob_ab_sin /= 20.0
        var gmob_ab_sin -= 1.0
        var gmob_ab_sin *= var gmob_ab_arg
        var gmob_ab_sin *= var gmob_ab_arg
        var gmob_ab_sin /= 6.0
        var gmob_ab_sin += 1.0
        var gmob_ab_sin *= var gmob_ab_arg 
        var gmob_ab_cos = var gmob_ab_arg 
        var gmob_ab_cos *= var gmob_ab_arg
        var gmob_ab_cos /= 12.0
        var gmob_ab_cos -= 1.0
        var gmob_ab_cos *= var gmob_ab_arg
        var gmob_ab_cos *= var gmob_ab_arg
        var gmob_ab_cos /= 2.0
        var gmob_ab_cos += 1.0
    if (inRegion "Sandworm Attacking", globalvar gmob_ab = 1) {
        var gmob1_ab_sin = var gmob_ab_sin
        var gmob1_ab_cos = var gmob_ab_cos
        var gmob1_ab_sin *= -30.0
        var gmob1_ab_cos *= -30.0
        changeVelocity = %var.player/gmob1_ab_sin% 3 %var.player/gmob1_ab_cos%
    }
    var gmob_ab_sin unset
        var gmob_ab_cos unset
        var gmob_ab_arg unset
goto function "Global Mob Ability Occur"
    if (var mobid = 101, globalvar gmobhp1 <= globalvar gmobhp1_p1, globalvar gmob1_p = 0 0) {
        globalvar gmob1_event *= -1
        globalvar gmob1_event += 3
    }
    if (var mobid = 101, globalvar gmobhp1 <= globalvar gmobhp1_p2, globalvar gmob1_p = 1 0) {
        globalvar gmob1_p += 1
        globalvar gmob_ab = 1
        function "Global Mob Ability" true  
    }
    if (var mobid = 101, globalvar gmobhp1 <= globalvar gmobhp1_p3, globalvar gmob1_p = 2 0) {
        globalvar gmob_ab = 1
        function "Global Mob Ability" true
    }
    if () {
        globalvar gmobhp1_p1 = globalvar gmaxmobhp1
        globalvar gmobhp1_p2 = globalvar gmaxmobhp1
        globalvar gmobhp1_p3 = globalvar gmaxmobhp1
        globalvar gmobhp1_p1 *= 5
        globalvar gmobhp1_p1 /= 8
        globalvar gmobhp1_p2 /= 2
        globalvar gmobhp1_p3 /= 4
    }

//Boss
if (var attacking = 1 0) {
    exit
} else {
    var attacking = 1
}
var mobid = 101
var moblv = 12
var mobstr = 15
var bdropchance1 = 60.0
var bdropchance2 = 30.0
var bdropchance3 = 10.0
var bdropchance4 = 3.0
var bdropchance5 = 25.0
var bdropchance6 = 50.0
var bdropchance7 = 25.0
var bdropchance8 = 25.0
function "Attacking"

