// --- 実行 ---
function "Pets Stats 1"
pause 10

// --- 初期化①（25個以内） ---
if () {
    var tmp unset
    var petformulavar1 unset
    var petvar1 unset
    var petvar2 unset
    var petvar3 unset
    var petvar4 unset
    var petvar5 unset
    var petvar6 unset
    var petvar7 unset
    var petvar8 unset
    var petvar9 unset
    var petvar10 unset
    var petvar11 unset
    var petvar12 unset
    var petvar13 unset
    var petvar14 unset
    var petvar15 unset
    var petvar16 unset
    var petvar17 unset
    var petvar18 unset
}

function "Pets Formula 1"
closeMenu
pause 5
if (var petvar1 = 2, var pettake = 1) {
    sound "Orb Pickup" 0.7 1.0 "Invokers Location"
    chat "&7[&c!&7] &cDespawned your pet!"
    giveItem slot_28 true
    var petstorage1 += 1
    var petsummoned = 0
    function "Pets Formula 1"
    displayMenu "Pets Menu"
    exit
}
if (var petvar1 = 6, var pettake = 1) {
    sound "Orb Pickup" 0.7 1.0 "Invokers Location"
    chat "&7[&c!&7] &cTook your pet!"
    giveItem slot_28 true
    var petstorage1 -= 1
    function "Pets Formula 1"
    displayMenu "Pets Menu"    
    exit
}
if (var petvar1 = 2) {
    sound "Orb Pickup" 0.7 1.0 "Invokers Location"
    chat "&7[&c!&7] &cDespawned your pet!"
    var petstorage1 += 2
    var petsummoned = 0
    function "Pets Formula 1"
    displayMenu "Pets Menu"
    exit
}
if (var petsummoned = 1) {
    sound "Anvil Land" 0.7 1.0 "Invokers Location"
    chat "&7[&c!&7] &cYou already summoned another pet!"
    exit
}
if (var tlevel < 14) {
    sound "Anvil Land" 0.7 1.0 "Invokers Location"
    chat "&7[&c!&7] &cYou don't have enough level to spawn this pet!"
    exit
}
if (var petvar1 = 6) {
    sound "Orb Pickup" 0.7 1.0 "Invokers Location"
    chat "&7[&a!&7] Successfully summoned your pet!"
    var petstorage1 -= 2
    var petsummoned = 1
    function "Pets Formula 1"
    displayMenu "Pets Menu"
    exit
}
if (hasItem slot_28 Metadata Anywhere "Any Amount") {
    removeItem slot_28 true
    sound "Orb Pickup" 0.7 1.0 "Invokers Location"
    chat "&7[&a!&7] Successfully summoned your pet!"
    var petstorage1 -= 1
    var petsummoned = 1
    function "Pets Formula 1"
    displayMenu "Pets Menu"
    exit
}
chat "&7[&c!&7] &cYou don't have the pet!"
sound "Anvil Land" 0.7 1.0 "Invokers Location"


goto function "Pets Stats 1"
    if () {
        var petmaxhp = 0
        var petdef = 0
        var petstr = 0
        var petcc = 0
        var petcd = 0
        var pethpr = 0
        var petmaxmana = 0
        var peteff = 0
        var petwoodmf = 0
        var petminemf = 0
        var petfxpmulti = 0
        var petmaxoxygen = 0
        var pethprmulti = 0
        var peteffmulti = 0
        var petstrmulti = 0
    }
    if (var petvar1 = 2) {
        var peteff += 5 
        var petwoodmf += 7
        var petmaxhp += 10
        var petstr += 5
        var petfxpmulti += %var.player/tlevel%
    }

goto command "/logs"
    if () {
        var pavar1 = %var.player/petstorage1%
        var pavar1 /= 2
        var pavar1 *= 2
        var pavar1 -= %var.player/petstorage1%
    }
    if or (var pavar1 = -2, var pavar1 = 0, hasItem slot_29 Metadata Anywhere "Any Amount") {
        chat "&7[&a!&7] &7Successfully opened &aLogs Bag&7!"
        sound "Orb Pickup"
        displayMenu "Logs"
    } else {
        chat "&7[&c!&7] &cERROR! You don't have &9Timber Wolf Pet &cto use this command!"
        sound "Anvil Land"
        exit
    }
    
