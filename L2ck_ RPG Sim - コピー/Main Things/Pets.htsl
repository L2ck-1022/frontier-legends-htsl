goto function "Pets Stats 1"
    if (var petvar2 = 2) {
        var petdef += 10
        var peteffmulti += 20
        var pethprmulti += 30
        var petmaxoxygen += 50
        var petab = 2

    }
    if (var petvar3 = 2) {
        var petmaxhp += 20
        var petdef += 5
        var petstrmulti += 15
        var petab = 3
    }
goto function "Pets Ability 1"
    if (var petab = 1) {
        var petfxpmulti += %var.player/tlevel%
    }
    if (var petab = 3) {
        var petmfvar = %var.player/str%
        var petmfvar /= 25
        var petmf = %var.player/petmfvar%
        var petmfvar unset
    }
goto function "Attack Skill 1"
    if (var mobhp = %var.player/maxmobhp%, var petab = 3, placeholder %random.int/1 101% <= 50) {
        var takendmg = 0
    }