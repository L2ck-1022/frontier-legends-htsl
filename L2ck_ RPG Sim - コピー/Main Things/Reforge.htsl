// ============================================================
//  REFORGE SYSTEM - Hypixel Housing HTSL  v3.0
// ============================================================
//
//  [Functions: 8 total]
//    reforge_copy       : copy lore vars to slot vars, display GUI
//    reforge_diff       : compute stat diffs and lore vars
//    reforge_calc_helm  : calc all IDs for helm slot
//    reforge_calc_chest : calc all IDs for chest slot
//    reforge_calc_legs  : calc all IDs for legs slot
//    reforge_calc_boots : calc all IDs for boots slot
//    reforge_calc_weap  : calc all IDs for weapon slot
//    reforge_do         : cost+roll+zero+calc+diff+copy
//
//  [Continuous museum_points scaling — per stat]
//    Each stat gets:
//      base value: %random.int/LO HI%  (fixed base range)
//      bonus:      floor(museum_points / DIVISOR)
//    Both lower bound and upper bound rise by the same bonus,
//    shifting the entire range upward continuously with museum_points.
//
//    Scaling: base * (1 + museum_points / 100)
//      = base + base * museum_points / 100  (long arithmetic)
//    MP=100 → values and range both double (×2.0)
//
//  [randomint: MAX is exclusive, so HI is written as desired_max+1]
//
//  [Reforge IDs]
//    1  Fierce      : str, cd
//    2  Fortified   : def, maxhp
//    3  Mystical    : maxmana, mf
//    4  Hasty       : eff, woodmf
//    5  Precise     : cc, cd
//    6  Runic       : maxmana, rhp
//    7  Vital       : maxhp, rhp
//    8  Warded      : def, cc
//    9  Prosperous  : minemf, woodmf
//    10 Swifty      : eff, minemf
//    11 Blessed     : mf, cc
//    12 Void        : def, str
//    13 Legendary   : str, def, maxhp
//
//  [Museum Point unlock thresholds for roll pool]
//    0pt+  : IDs 1-6   (%random.int/1 7%)
//    20pt+ : IDs 1-8   (%random.int/1 9%)
//    50pt+ : IDs 1-11  (%random.int/1 12%)
//    100pt+: IDs 1-13  (%random.int/1 14%)
//
//  [Cost per reforge]
//    Gems : 5
//    Gold : museum_points * 100
//    XP   : floor(reqxp / 10)
//
// ============================================================


// ------------------------------------------------------------
//  [Function] reforge_calc_b  (IDs 7-13)
//  _b = floor(museum_points / 12) computed at top (outer var).
//  Base randomint and bonus addition are both inside if-blocks
//  so they do not count toward the 25-var limit.
//  if count: 1(skip) + 7IDs×2if = 15 ifs  ✓
//  var count: 3 (_b set, /=, _rid dummy) ✓
// ------------------------------------------------------------


goto function "reforge_calc"

if (var _sid = 1 0) {
    var _base set %random.decimal/3000.0 8000.0%
    var _base /= 1000.0
    var ref_str += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_str += var _base
    var _base set %random.decimal/5000.0 12000.0%
    var _base /= 1000.0
    var ref_cd += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_cd += var _base
}
if (var _sid = 2 0) {
    var _base set %random.decimal/4000.0 10000.0%
    var _base /= 1000.0
    var ref_def += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_def += var _base
    var _base set %random.decimal/5000.0 12000.0%
    var _base /= 1000.0
    var ref_maxhp += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_maxhp += var _base
}
if (var _sid = 3 0) {
    var _base set %random.decimal/5000.0 12000.0%
    var _base /= 1000.0
