goto function "reforge_do"

// 1. Gem check
if (var gem < 5 0) {
    chat "&7[&c!&7] &c&lERROR! &cNot enough gems! &7(need &e5&7)"
    sound "Anvil Land" 0.7 1.0 "invokers_location"
    exit
}

// 2. Gold check
var _rgold set var museum_points
var _rgold *= 100
if (var gold < var _rgold 0) {
    chat "&7[&c!&7] &c&lERROR! &cNot enough gold!"
    sound "Anvil Land" 0.7 1.0 "invokers_location"
    var _rgold unset
    exit
}

// 3. Deduct gems + gold
var gem    -= 5
var gold   -= var _rgold
var _rgold unset

// 4. Deduct XP
var _rxpcost set var reqxp
var _rxpcost /= 10
var xp       -= var _rxpcost
var _rxpcost unset
pause 5

// 5. Roll new reforge ID (keep _rid alive for reforge_diff)
var _rid set %random.int/1 6%
if (var museum_points >= 20 0) {
    var _rid set %random.int/1 9%
}
if (var museum_points >= 50 0) {
    var _rid set %random.int/1 12%
}
if (var museum_points >= 100 0) {
    var _rid set %random.int/1 14%
}

// 6. Write rolled ID to slot
if (var _rslot = 1 0) {
    var reforge_helm set var _rid
}
if (var _rslot = 2 0) {
    var reforge_chest set var _rid
}
if (var _rslot = 3 0) {
    var reforge_legs set var _rid
}
if (var _rslot = 4 0) {
    var reforge_boots set var _rid
}
if (var _rslot = 5 0) {
    var reforge_weapon set var _rid
}

// 6.5. Convert museum_points to double for calc
var _mpd set %var.player/museum_points%D

// 7. Zero all ref stats
if () {
    var ref_maxhp   set 0.0
    var ref_def     set 0.0
    var ref_str     set 0.0
    var ref_mf      set 0.0
    var ref_eff     set 0.0
    var ref_rhp     set 0.0
    var ref_maxmana set 0.0
    var ref_cc      set 0.0
    var ref_cd      set 0.0
    var ref_woodmf  set 0.0
    var ref_minemf  set 0.0
}

// 8. Calculate target slot only → ref_* = new reforge single-slot values
if (var _rslot = 1 0) {
    var _sid set var reforge_helm
}
if (var _rslot = 2 0) {
    var _sid set var reforge_chest
}
if (var _rslot = 3 0) {
    var _sid set var reforge_legs
}
if (var _rslot = 4 0) {
    var _sid set var reforge_boots
}
if (var _rslot = 5 0) {
    var _sid set var reforge_weapon
}
function "reforge_calc" false
var _sid unset

// 8.5. Convert single-slot ref_* to long for display
if () {
    var ref_maxhp set %var.player/ref_maxhp%L
    var ref_def set %var.player/ref_def%L
    var ref_str set %var.player/ref_str%L
    var ref_mf set %var.player/ref_mf%L
    var ref_eff set %var.player/ref_eff%L
    var ref_rhp set %var.player/ref_rhp%L
    var ref_maxmana set %var.player/ref_maxmana%L
    var ref_cc set %var.player/ref_cc%L
    var ref_cd set %var.player/ref_cd%L
    var ref_woodmf set %var.player/ref_woodmf%L
    var ref_minemf set %var.player/ref_minemf%L
}

// 8.6. Save slot contribution to s{N}* vars
if (var _rslot = 1 0) {
    var s1st set var ref_str
    var s1cd set var ref_cd
    var s1df set var ref_def
    var s1hp set var ref_maxhp
    var s1mn set var ref_maxmana
    var s1mf set var ref_mf
    var s1ef set var ref_eff
    var s1wm set var ref_woodmf
    var s1cc set var ref_cc
    var s1rh set var ref_rhp
    var s1mi set var ref_minemf
}
if (var _rslot = 2 0) {
    var s2st set var ref_str
    var s2cd set var ref_cd
    var s2df set var ref_def
    var s2hp set var ref_maxhp
    var s2mn set var ref_maxmana
    var s2mf set var ref_mf
    var s2ef set var ref_eff
    var s2wm set var ref_woodmf
    var s2cc set var ref_cc
    var s2rh set var ref_rhp
    var s2mi set var ref_minemf
}
if (var _rslot = 3 0) {
    var s3st set var ref_str
    var s3cd set var ref_cd
    var s3df set var ref_def
    var s3hp set var ref_maxhp
    var s3mn set var ref_maxmana
    var s3mf set var ref_mf
    var s3ef set var ref_eff
    var s3wm set var ref_woodmf
    var s3cc set var ref_cc
    var s3rh set var ref_rhp
    var s3mi set var ref_minemf
}
if (var _rslot = 4 0) {
    var s4st set var ref_str
    var s4cd set var ref_cd
    var s4df set var ref_def
    var s4hp set var ref_maxhp
    var s4mn set var ref_maxmana
    var s4mf set var ref_mf
    var s4ef set var ref_eff
    var s4wm set var ref_woodmf
    var s4cc set var ref_cc
    var s4rh set var ref_rhp
    var s4mi set var ref_minemf
}
if (var _rslot = 5 0) {
    var s5st set var ref_str
    var s5cd set var ref_cd
    var s5df set var ref_def
    var s5hp set var ref_maxhp
    var s5mn set var ref_maxmana
    var s5mf set var ref_mf
    var s5ef set var ref_eff
    var s5wm set var ref_woodmf
    var s5cc set var ref_cc
    var s5rh set var ref_rhp
    var s5mi set var ref_minemf
}

// 9. Compute lore vars from single-slot ref_* (always positive)
function "reforge_diff" false

// 9.5. Sum all slot contributions into ref_*
function "reforge_sum" false

// 10. (removed: incremental update replaces full recalc)

// 11. Compute display costs
if () {
    var rf_cost_gems set 5
    var rf_cost_gold set var museum_points
    var rf_cost_gold *= 100
    var rf_cost_xp   set var reqxp
    var rf_cost_xp   /= 10
}

// 12. Copy to slot vars, display GUI, cleanup
function "reforge_copy" false


// ------------------------------------------------------------
//  [Command] /reforge
// ------------------------------------------------------------
goto command "reforge"

var rf_cost_gems set 5
var rf_cost_gold set var museum_points
var rf_cost_gold *= 100
var rf_cost_xp   set var reqxp
var rf_cost_xp   /= 10
displayMenu "Reforge"
pause 5
if () {
    var rf_cost_gems unset
    var rf_cost_gold unset
    var rf_cost_xp   unset
}


// ------------------------------------------------------------
//  GUI Slot Actions (Slot 10=Helm 11=Chest 12=Legs 13=Boots 15=Weapon)
// ------------------------------------------------------------
goto gui "Reforge" "10"
var _rslot set 1
function "reforge_do" false

goto gui "Reforge" "11"
var _rslot set 2
function "reforge_do" false

goto gui "Reforge" "12"
var _rslot set 3
function "reforge_do" false

goto gui "Reforge" "13"
var _rslot set 4
function "reforge_do" false

goto gui "Reforge" "15"
var _rslot set 5
function "reforge_do" false


// ============================================================
//  [Setup — initialize on first join]
//    reforge_helm=0, reforge_chest=0, reforge_legs=0,
//    reforge_boots=0, reforge_weapon=0
//    ref_maxhp=0, ref_def=0, ref_str=0, ref_mf=0,
//    ref_eff=0, ref_rhp=0, ref_maxmana=0, ref_cc=0,
//    ref_cd=0, ref_woodmf=0, ref_minemf=0
//    gem=0, gold=0, xp=0, reqxp=100, level=1
// ============================================================


goto function "reforge_sum"
if () {
    var ref_str set var s1st
    var ref_str += var s2st
    var ref_str += var s3st
    var ref_str += var s4st
    var ref_str += var s5st
    var ref_cd set var s1cd
    var ref_cd += var s2cd
    var ref_cd += var s3cd
    var ref_cd += var s4cd
    var ref_cd += var s5cd
    var ref_def set var s1df
    var ref_def += var s2df
    var ref_def += var s3df
    var ref_def += var s4df
    var ref_def += var s5df
    var ref_maxhp set var s1hp
    var ref_maxhp += var s2hp
    var ref_maxhp += var s3hp
    var ref_maxhp += var s4hp
    var ref_maxhp += var s5hp
    var ref_maxmana set var s1mn
    var ref_maxmana += var s2mn
    var ref_maxmana += var s3mn
    var ref_maxmana += var s4mn
    var ref_maxmana += var s5mn
    var ref_mf set var s1mf
    var ref_mf += var s2mf
    var ref_mf += var s3mf
    var ref_mf += var s4mf
    var ref_mf += var s5mf
    var ref_eff set var s1ef
    var ref_eff += var s2ef
    var ref_eff += var s3ef
    var ref_eff += var s4ef
    var ref_eff += var s5ef
    var ref_woodmf set var s1wm
    var ref_woodmf += var s2wm
    var ref_woodmf += var s3wm
    var ref_woodmf += var s4wm
    var ref_woodmf += var s5wm
    var ref_cc set var s1cc
    var ref_cc += var s2cc
    var ref_cc += var s3cc
    var ref_cc += var s4cc
    var ref_cc += var s5cc
    var ref_rhp set var s1rh
    var ref_rhp += var s2rh
    var ref_rhp += var s3rh
    var ref_rhp += var s4rh
    var ref_rhp += var s5rh
    var ref_minemf set var s1mi
    var ref_minemf += var s2mi
    var ref_minemf += var s3mi
    var ref_minemf += var s4mi
    var ref_minemf += var s5mi
}


goto function "reforge_diff"

if (var _rid = 1 0) {
    var rf_name set "Fierce"
    var rf_v1 set var ref_str
    var rf_icon1 set "&8❁ Strength"
    var rf_v2 set var ref_cd
    var rf_icon2 set "&8☣ Crit Damage"
    var rf_v3    set -1
