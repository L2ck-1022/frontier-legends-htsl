    var _base /= 1000.0
    var ref_woodmf += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_woodmf += var _base
}
if (var _sid = 5 0) {
    var _base set %random.decimal/1000.0 4000.0%
    var _base /= 1000.0
    var ref_cc += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_cc += var _base
    var _base set %random.decimal/6000.0 14000.0%
    var _base /= 1000.0
    var ref_cd += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_cd += var _base
}
if (var _sid = 6 0) {
