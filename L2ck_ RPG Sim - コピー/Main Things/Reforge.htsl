    var _base *= var _mpd
    var _base /= 100.0
    var ref_maxmana += var _base
    var _base set %random.decimal/2000.0 7000.0%
    var _base /= 1000.0
    var ref_rhp += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_rhp += var _base
}
if (var _sid = 7 0) {
    var _base set %random.decimal/6000.0 14000.0%
    var _base /= 1000.0
    var ref_maxhp += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_maxhp += var _base
    var _base set %random.decimal/3000.0 8000.0%
    var _base /= 1000.0
    var ref_rhp += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_rhp += var _base
}
if (var _sid = 8 0) {
    var _base set %random.decimal/5000.0 12000.0%
    var _base /= 1000.0
    var ref_def += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_def += var _base
    var _base set %random.decimal/1000.0 4000.0%
    var _base /= 1000.0
    var ref_cc += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_cc += var _base
}
if (var _sid = 9 0) {
    var _base set %random.decimal/2000.0 7000.0%
    var _base /= 1000.0
    var ref_minemf += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_minemf += var _base
    var _base set %random.decimal/2000.0 7000.0%
    var _base /= 1000.0
    var ref_woodmf += var _base
