    var _base *= var _mpd
    var _base /= 100.0
    var ref_mf += var _base
    var _base set %random.decimal/1000.0 4000.0%
    var _base /= 1000.0
    var ref_cc += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_cc += var _base
}
if (var _sid = 12 0) {
    var _base set %random.decimal/4000.0 10000.0%
    var _base /= 1000.0
    var ref_def += var _base
    var _base *= var _mpd
    var _base /= 100.0
