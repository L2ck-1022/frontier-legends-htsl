    var _base /= 1000.0
    var ref_str += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_str += var _base
    var _base set %random.decimal/5000.0 12000.0%
    var _base /= 1000.0
    var ref_def += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_def += var _base
    var _base set %random.decimal/8000.0 18000.0%
    var _base /= 1000.0
    var ref_maxhp += var _base
    var _base *= var _mpd
    var _base /= 100.0
    var ref_maxhp += var _base
