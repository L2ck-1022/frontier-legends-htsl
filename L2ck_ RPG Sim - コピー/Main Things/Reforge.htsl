    var rf_v2    set -1
    var rf_v3    set -1
    var rf_icon1 unset
    var rf_icon2 unset
    var rf_icon3 unset
}

if () {
    var _rid unset
}

goto function "reforge_copy"

// Always copy rf_name
if (var _rslot = 1 0) {
    var rf_name_1 set var rf_name
}
if (var _rslot = 2 0) {
    var rf_name_2 set var rf_name
}
if (var _rslot = 3 0) {
    var rf_name_3 set var rf_name
}
if (var _rslot = 4 0) {
    var rf_name_4 set var rf_name
}
if (var _rslot = 5 0) {
    var rf_name_5 set var rf_name
}

// Multi-stage expansion (rf_v1 >= 1)
if and (var _rslot = 1 0, var rf_v1 >= 1 0) {
    var $4 set %var.player/rf_v1%L
    var $5 set var rf_icon1
    var rf_icon1_1 set "%var.player/$4% %var.player/$5%"
    var rf_icon1_1 set "&a+%var.player/rf_icon1_1%"
    var $6 set %var.player/rf_v2%L
    var $7 set var rf_icon2
    var rf_icon2_1 set "%var.player/$6% %var.player/$7%"
    var rf_icon2_1 set "&a+%var.player/rf_icon2_1%"
    var rf_icon3_1 unset
}
if and (var _rslot = 2 0, var rf_v1 >= 1 0) {
    var $4 set %var.player/rf_v1%L
    var $5 set var rf_icon1
    var rf_icon1_2 set "%var.player/$4% %var.player/$5%"
    var rf_icon1_2 set "&a+%var.player/rf_icon1_2%"
    var $6 set %var.player/rf_v2%L
    var $7 set var rf_icon2
    var rf_icon2_2 set "%var.player/$6% %var.player/$7%"
    var rf_icon2_2 set "&a+%var.player/rf_icon2_2%"
    var rf_icon3_2 unset
}
if and (var _rslot = 3 0, var rf_v1 >= 1 0) {
    var $4 set %var.player/rf_v1%L
    var $5 set var rf_icon1
    var rf_icon1_3 set "%var.player/$4% %var.player/$5%"
    var rf_icon1_3 set "&a+%var.player/rf_icon1_3%"
    var $6 set %var.player/rf_v2%L
    var $7 set var rf_icon2
    var rf_icon2_3 set "%var.player/$6% %var.player/$7%"
    var rf_icon2_3 set "&a+%var.player/rf_icon2_3%"
    var rf_icon3_3 unset
}
if and (var _rslot = 4 0, var rf_v1 >= 1 0) {
    var $4 set %var.player/rf_v1%L
    var $5 set var rf_icon1
    var rf_icon1_4 set "%var.player/$4% %var.player/$5%"
    var rf_icon1_4 set "&a+%var.player/rf_icon1_4%"
    var $6 set %var.player/rf_v2%L
    var $7 set var rf_icon2
    var rf_icon2_4 set "%var.player/$6% %var.player/$7%"
    var rf_icon2_4 set "&a+%var.player/rf_icon2_4%"
    var rf_icon3_4 unset
}
if and (var _rslot = 5 0, var rf_v1 >= 1 0) {
    var $4 set %var.player/rf_v1%L
    var $5 set var rf_icon1
    var rf_icon1_5 set "%var.player/$4% %var.player/$5%"
    var rf_icon1_5 set "&a+%var.player/rf_icon1_5%"
    var $6 set %var.player/rf_v2%L
    var $7 set var rf_icon2
    var rf_icon2_5 set "%var.player/$6% %var.player/$7%"
    var rf_icon2_5 set "&a+%var.player/rf_icon2_5%"
    var rf_icon3_5 unset
}

// Copy stat3 (Legendary only, rf_v3 >= 0)
if and (var _rslot = 1 0, var rf_v3 >= 0 0) {
    var $8 set %var.player/rf_v3%L
    var $9 set var rf_icon3
    var rf_icon3_1 set "%var.player/$8% %var.player/$9%"
    var rf_icon3_1 set "&a+%var.player/rf_icon3_1%"
}
if and (var _rslot = 2 0, var rf_v3 >= 0 0) {
    var $8 set %var.player/rf_v3%L
    var $9 set var rf_icon3
    var rf_icon3_2 set "%var.player/$8% %var.player/$9%"
    var rf_icon3_2 set "&a+%var.player/rf_icon3_2%"
}
if and (var _rslot = 3 0, var rf_v3 >= 0 0) {
    var $8 set %var.player/rf_v3%L
    var $9 set var rf_icon3
    var rf_icon3_3 set "%var.player/$8% %var.player/$9%"
    var rf_icon3_3 set "&a+%var.player/rf_icon3_3%"
}
if and (var _rslot = 4 0, var rf_v3 >= 0 0) {
    var $8 set %var.player/rf_v3%L
    var $9 set var rf_icon3
    var rf_icon3_4 set "%var.player/$8% %var.player/$9%"
    var rf_icon3_4 set "&a+%var.player/rf_icon3_4%"
}
if and (var _rslot = 5 0, var rf_v3 >= 0 0) {
    var $8 set %var.player/rf_v3%L
    var $9 set var rf_icon3
    var rf_icon3_5 set "%var.player/$8% %var.player/$9%"
    var rf_icon3_5 set "&a+%var.player/rf_icon3_5%"
}

// Cleanup non-slot temps
if () {
    var _mpd     unset
    var rf_name  unset
    var rf_v1    unset
    var rf_v2    unset
    var rf_v3    unset
    var rf_icon1 unset
    var rf_icon2 unset
    var rf_icon3 unset
}

var _rslot unset
chat "&7[&a!&7] &fReforge complete!"
sound "Level Up" 1 1 "invokers_location"
displayMenu "Reforge"

pause 5

if () {
    var $4 unset
    var $5 unset
    var $6 unset
    var $7 unset
    var $8 unset
    var $9 unset
    var rf_cost_gems unset
    var rf_cost_gold unset
    var rf_cost_xp   unset
}