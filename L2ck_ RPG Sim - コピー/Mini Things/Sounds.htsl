goto function "Sounds"
    if (var sound = 1) {
        sound "Orb Pickup" 0.7 2.0 "Invokers Location"
        sound "Successful Hit" 0.7 1.2 "Invokers Location"
    }
    if (var sound = 2) {
        sound "Orb Pickup" 0.7 1.5 "Invokers Location"
        sound "Successgul Hit" 0.7 0.7 "Invokers_Location"
    }
    if (var sound = 3) {
        sound note.pling 0.7 2.0 "custom_coordinates" "~ ~ ~"
        sound note.pling 0.4 1.3 "custom_coordinates" "~ ~ ~"
        sound note.pling 0.4 1.5 "custom_coordinates" "~ ~ ~"
        pause 3
        sound note.pling 0.7 2.0 "custom_coordinates" "~ ~ ~"
        sound note.pling 0.4 1.3 "custom_coordinates" "~ ~ ~"
        sound note.pling 0.4 1.5 "custom_coordinates" "~ ~ ~"
    }
    if (var sound = 4) {
        sound "Horse Saddle" 0.7 0.7 "Invokers Location"
        sound "Click" 0.7 0.8 "Invokers Location"
        sound "Sheep Shear" 0.2 0.1 "Invokers Location"
        sound "Zombie Unfect" 0.2 1.5 "Invokers Location"
    }
    if (var sound = 5) {
        sound "Horse Zombie Idle" 0.7 0.7 "Invokers Location"
        sound "Click" 0.7 0.8 "Invokers Location"
        sound "Enderman Teleport" 0.7 1.2 "Invokers Location"
    }
    if (var sound = 6) {
        sound "Horse Gallop" 0.5 0.6 "Invokers Location"
        sound "Enderman Teleport" 0.7 0.0 "Invokers Location"
    }
    if (var sound = 7) {
        sound "Note Pling" 0.7 1.3 "Invokers Location"
        sound "Firework Launch" 0.7 1.0 "Invokers Location"
        sound "Firework Twinkle2" 0.7 1.0 "Invokers Location"
        sound "Villager Yes" 0.7 0.7 "Invokers Location"
    }