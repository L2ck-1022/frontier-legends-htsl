goto function "Skill Stats 1"
    //Scorched Cleaver
    if (var asvar1 >= 1 0) {
        var asvar1 -= 1
        var defmulti += 10
    } else {
        var asvar1 unset
    }
    if (var asvar2 >= 1 0) {
        var asvar2 -= 1
        var def += 10
    } else {
        var asvar2 unset
    }
    if (var asvar3 >= 1 0) {
        var asvar3 = -1
        var str += 10
    } else {
        var asvar3 unset
    }
    if (var msvar1 >= 1 0) {
        var msvar1 -= 1
        var eff += 3
    } else {
        var msvar1 unset
    }
    //Miner's Hammer
    if (hasItem slot_4 Metadata Anywhere "Any Amount") {
        var effmulti += 20
    }
    //Gemblade
    if (hasItem slot_5 Metadata Hand "Any Amount") {
        var allmulti += 3
    }
    //Sprint Boots
    if (hasItem slot_13 Metadata Armor "Any Amount") {
        applyPotion "Speed" 5 1 true true
    }
goto function "Attack Skill 1"
    //Scorched Cleaver
    if (hasItem slot_1 Metadata Hand "Any Amount", var level >= 26 , placeholder %random.int/1 101% <= 10) {
        var asvar1 = 20
    }
    //Dry Bayonet
    if (hasItem slot_2 Metadata Hand "Any Amount", var level >= 26 , placeholder %random.int/1 101% <= 20) {
        var dmgmulti += 100
    }
    //Thunder Bow
    if (hasItem slot_3 Metadata Hand "Any Amount", var level >= 30 , placeholder %random.int/1 101% <= 20)
    //Nomad Plate
    if (hasItem slot_11 Metadata Armor "Any Amount", var level >= 26 , placeholder %random.int/1 101% <= 10) {
        var takendmg = 0
    }
    //Storm Leggings
    if (hasItem slot_12 Metadata Armor  "Any Amout", var level >= 30 , var takendmg >= 1, placeholder %random.int/1 101% <= 5) {
        var asvar2 = 20
    }  
    //Thunder Full Set Bonus
    if (hasItem slot_1 Metadata Hand "Any Amount", hasItem slot_2 Metadata Armor "Any Amount", var accvar >= 1, var level >= 30, var crit = 1 0) {
        var asvar3 = 12
    } else {
        var accvar unset
    }
goto function "Mining Skill 1"    
    if (hasItem slot_28 Metadata Anywhere "Any Amount", hasItem slot_29 Metadata Armor "Any Amount", var accvar >= 1, var level >= 27, placeholder "%random.int/1 101%" <= 5) {
        var msvar1 = 20
    }                                                                                                                                                                                        
    
