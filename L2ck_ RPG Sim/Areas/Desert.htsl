goto function "Mob Abilities"
    if () {
        var resistancevar = %var.player/resistance%
        var resistancevar /= 1000
        var resistancevar *= 1000
        var resistancevar -= %var.player/resistance%
        var resistancevar *= -1
    }
    if (var mobid = 11, placeholder %random.int/1 201% > %var.player/resistancevar%) {
        applyPotion "Poison" 5 1 true
    }
    if () {
        var resistancevar = %var.player/resistance%
        var resistancevar /= 1000
    }
    if (var mobid = 14, placeholder %random.int/1 201% > %var.player/resistancevar%) {
        applyPotion "Wither" 5 1 true
    }

goto event "Player Damage"
if (damageCause "Poison") {
        cancelEvent
        var mobpoisondmg = %var.player/hp%
        var mobpoisondmg /= 5
        var hp -= %var.player/mobpoisondmg%
        var mobpoisondmg unset
        sound "Burp" 0.7 1.5 "Invokers Location"
    }
if (hasPotion "Wither") {
    cancelEvent
