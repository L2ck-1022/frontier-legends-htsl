goto function "Drop Item Detect 1"
    if (var q1var1 = 1) {
        var q1var2 = 1
    } else {
        var q1var2 unset
    }
    var q1 = %var.player/qstorage1% 
    var q1 /= 10
    var q1 *= 10
    var q1 -= %var.player/qstorage1%
    if (var q1 = 0, var dropped1 = 1, var dropchance1 <= 7 0, var dropchance1 > 0 0) {
        var q1var1 += 1
        var dropped1 unset
    }
    if (var q1 = 0, var dropped2 = 1, var dropchance2 <= 7 0, var dropchance2 > 0 0) {
        var q1var1 += 1
        var dropped2 unset
    }
    if (var q1 = 0, var dropped3 = 1, var dropchance3 <= 7 0, var dropchance3 > 0 0) {
        var q1var1 += 1
        var dropped3 unset
    }
    if (var q1 = 0, var dropped4 = 1, var dropchance4 <= 7 0, var dropchance4 > 0 0) {
        var q1var1 += 1
        var dropped4 unset
    }
    if (var q1var1 = 1, var q1var2 = 1) {
        var q1var1 unset
        var q1var2 unset
    }
    if (var q1 = 0, var q1var1 = 2) {
        chat &a
        chat "&a✍ &a&lLucky 7&a Quest&8 Completed:"
        chat "&8↳ &a+&a&knanika"
        chat &a
        var qstorage1 += 2
        var sound = 7
        var q1var1 unset
