goto function "Fierce"
    var fiercevar = %var.player/fierce%
    if or (placeholder %random.int/1 101% <= %var.player/fierce%, var extraattack = 1 0) {
        var fiercevar -= 100
    } else {
        var fiercevar unset
        var fiercetime unset
        exit
    }
    if (var extraattack >= 1 0) {
        var fiercevar += 100
        var extraattack -= 1 
        var extraattacktime += 1
    } else {
        var fiercetime += 1
        var extraattacktime unset
        var extraattack unset
    }
