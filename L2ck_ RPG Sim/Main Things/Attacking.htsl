goto function "Attacking"
    if (var level < %stat.player/moblv%) {
        chat "&7[&c!&7] &cYou don't have enough level to attack this mob! &8[&7%stat.player/level%&8/%stat.player/moblv%]"
        sound random.anvil_land 0.7 1.0 invokers_location
        var mobid Unset
        var moblv Unset
        var maxmobhp Unset
        var mobstr Unset
        var mobxp Unset
        var mobgold unset
        pause 5
        var attacking = 0
        exit
    }
    if (var mobid = %var.player/prevmobid% 0) {
    } else {
        var mobhp = %var.player/maxmobhp%
        var prevmobid = %var.player/mobid%
    }
    if (placeholder "%random.int/1 101%" <= %stat.player/cc%) {
        var damage = %stat.player/str% 
        var crit = 1 
        var damage *= %stat.player/cd% 
        var damage /= 100
    } else {
        var damage = %stat.player/str% 
        var crit unset
    }
    if (var takendmgtime = 0 0) {
        var takendmgtime = 5 true
    }
    if () {
        var takendmg = %var.player/def%
        var takendmg *= 100
        var defvar = %var.player/moblv%
        var defvar /= 2
        var defvar += %var.player/def% 
        var takendmg /= %var.player/defvar%
        var takendmg -= 100
        var takendmg *= -1
        var takendmg *= %var.player/mobstr%
        var takendmg /= 100
    }
    if (var mobid <= 100 0) {
        function "Attack Skill 1"
        var damage *= %var.player/damagemulti%
        var damage /= 100
        var mobhp -= %stat.player/damage% 
        var mobhpper = %stat.player/mobhp% 
        var mobhpper *= 100 
        var mobhpper /= %stat.player/maxmobhp% 
    }
    if (var mobid >= 101 0) {
        function "Attack Skill 1"
        var damage *= var damagemulti
        var damage /= 100
        function "Global Mob Data"
        var mobhpper = var mobhp
        var mobhpper *= 100
        var mobhpper /= var maxmobhp
    }
    var damagedisplay = %var.player/damage%
    function "Attacking Title"
    function "Mob Abilities"
    if (var mobid >= 101 0) {
        function "Global Mob Ability Occur"
        function "Global Mob Kill Detect"
        exit
    }
    if (var mobhp <= 0) {
        var actionbar = 1
        var killed += 1
        var mobhp = %var.player/maxmobhp%
        var mobxp *= %var.player/mobxpmulti%
        var mobxp /= 100
        var mobgold *= %var.player/mobgoldmulti%
        var mobgold /= 100
        var gold += var mobgold
        var xp += %var.player/mobxp%
        var droptimes += 1
        title "&4[ &c❤ &c&l0 &8/%stat.player/maxmobhp% &4]" "&a&lKILLED! &8( &b+%stat.player/mobxp%✧ &8)" 0 1 1
        sound "Orb Pickup" 0.7 1.0 "Invokers Location"
        var crit unset
    }
    var fiercevar = var fierce
    goto function "Fierce/Extrahit"
    pause 5
    var attacking unset

goto function "Attacking Title"
    if (var crit = 0 0, var mobhpper >= 66 0) {
        title "&2[ &a❤ &l%stat.player/mobhp% &l&7/%stat.player/maxmobhp% &2]" "&a&l+%stat.player/damagedisplay% &2Damage" 0 1 1
    }
    if (var crit = 0 0, var mobhpper >= 33 0, var mobhpper < 66 0) {
