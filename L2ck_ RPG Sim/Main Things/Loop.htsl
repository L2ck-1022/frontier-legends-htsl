goto function "Action Bar"
    if (var actionbar = 0 0) {
        actionBar "&a%var.player/def%❈ &7|&f&l|[ &c&l❤ %var.player/hp% &4/ %var.player/maxhp% &f&l]|&7| &b&l✎ %var.player/mana% &3/ %var.player/maxmana%"
    }
    if (var actionbar = 1) {
        actionBar "&bLv &b&l%var.player/level% &3( &b&l%var.player/xp% &3/ %var.player/reqxp% ) ( +%var.player/mobxp% )"
    }
goto function "Stats"
    if (var hp <= 0, var revived = 1) {
        chat "&4&l&m----------------------------------------"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &4&lYou Died!"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &7You lost &4&l&n20% of your gold&7!"
        chat "&7Buy &a&lStronger Stuff &7or &a&lUpgrade Skill Tree&7..."
        chat "&a"
        chat "&4&l&m----------------------------------------"
        var gold *= 4
        var gold /= 5
        var hp = %var.player/maxhp%
        var mobhp = %var.player/maxmobhp%
    }
    var hpper = var hp
    var hpper *= 100
    var hpper /= var maxhp
    if () {
        var hpr = %var.player/maxhp%
        var hpr /= 20
        var maxhp = 20
        var def = 0
        var maxmana = 100
        var str = 0
        var cc = 20
        var cd = 150
        var hprspeed = 100
        var agility = 0
    }
    if () {
        var strmulti = 100
        var damagemulti = 100
        var mobxpmulti = 100
        var effmulti = 100
        var fxpmulti = 100
        var allmulti = 100
    }
    if () {
        var manar = 1
        var manarspeed = 100
        var resistance = 0
        var eff = 0
        var woodmf = 100
        var minemf = 100
        var tpower = 0
        var xpper = %var.player/xp%
        var xpper *= 100
        var xpper /= %var.player/reqxp%
        var mf = 100
    }
    if () {
        function "Item Stats 1 (Forest)"
        function "Item Stats 2 (Forest)"
    }
    if () {
        var maxhp += %var.player/accmaxhp%
        var def += %var.player/accdef%
        var str += %var.player/accstr%
        var cc += %var.player/acccc%
        var cd += %var.player/acccd%
        var hpr += %var.player/acchpr%
        var maxmana += %var.player/accmaxmana%
        var eff += %var.player/acceff%
        var woodmf += %var.player/accwoodmf%
    }
    if () {
        var maxhp += %var.player/petmaxhp%
        var def += %var.player/petdef%
        var str += %var.player/petstr%
        var cc += %var.player/petcc%
        var cd += %var.player/petcd%
        var hpr += %var.player/pethpr%
        var maxmana += %var.player/petmaxmana%
        var eff += %var.player/peteff%
        var woodmf += %var.player/petwoodmf%
        var minemf += %var.player/petminemf%
        var fxpmulti += %var.player/petfxpmulti%
    }
    if () {
        function "Consumables Stat"
    }
    if () {
        function "Skill Stats 1"
        function "Accessory Ability 1"
    }
    if (hasPotion "Wither") {
    var strmulti -= 50
    }
    if () {
        var str *= %var.player/strmulti%
        var str /= 100
        var fxp *= %var.player/fxpmulti%
        var fxp /= 100
    }

goto function "Loop"
    if (var playerid >= 1 0) {
    } else {
        exit
    }
    var pt_t += 5
    var drewardtime_t -= 1
    function "Action Bar"
    function "Level Up"
    function "Stats"
    function "Drop Items"
    if (var hprtick <= 0 0) {
        var hp += %var.player/hpr%
        var hprtick = 400
        var hprtick /= %var.player/hprspeed%
    } else {
        var hprtick -= 1
    }
    if (var manartick <= 0 0) {
        var mana += %var.player/manar%
        var manartick = 400
        var manartick /= %var.player/manarspeed%
    } else {
        var manartick -= 1
    }
    if (var hp >= %var.player/maxhp%) {
        var hp = %var.player/maxhp%
    }
    if (var mana >= %var.player/maxmana%) {
        var mana = %var.player/maxmana%
    }
    if (var takendmgtime = 1, hasItem slot_10 Metadata Armor "Any Amount", placeholder %random.int/1 101% <= 5) {
        var takendmgtime = 5
    }
    if (var takendmgtime = 1, var mobmagic = 0 0, hasItem slot_11 Metadata Armor "Any Amount", placeholder %random.int/1 101% <= 10) {
        var takendmgtime = 0
    }
    if (var takendmgtime = 1, takendmg > 0) {
        var takendmgtime -= 1
        var hp -= %var.player/takendmg%
    }

    // 全NPC共通の会話を自動送りする（会話中でなければ即終了するので軽量）
    function "Dialogue"


goto function "Second Loop"
    if (var poisontime >= 1 0) {
        var mobhp -= %var.player/poisondmg%
        var poisontime -= 1
        var mobhpper = %stat.player/mobhp% 
        var mobhpper *= 100 
        var mobhpper /= %stat.player/maxmobhp% 
        var crit unset
        var damagedisplay = %var.player/poisondmg%
        sound "Burp" 0.7 1.5 "Invokers Location"
    } else {
        var poisontime unset
        var poisondmg unset
    }
    if (var mobhp > 0 0) {
        function "Attacking Title"
    } else {
        var actionbar = 1
        var killed += 1
        var droptimes += 1
        var mobhp = %var.player/maxmobhp%
        var xp += %var.player/mobxp%
        title "&4[ &c❤ &c&l0 &8/%stat.player/maxmobhp% &4]" "&a&lKILLED! &8( &b+%stat.player/mobxp%✧ &8)" 0 1 1
        sound "Orb Pickup" 0.7 1.0 "Invokers Location"
        var crit unset
    }
    if (hasPotion "Poison") {
        var mobpoisondmg = %var.player/hp%
        var mobpoisondmg /= 5
        var hp -= %var.player/mobpoisondmg%
        var mobpoisondmg unset
    }

goto function "Level Up"
    if () {
        var reqxp = %var.player/level%
        var reqxp += 1
        var reqxp *= %var.player/level%
        var reqxp *= 25
        var reqxp' = var level
        var reqxp' *= var level
        var reqxp' *= var level
        var reqxp' /= 10
        var reqxp += var reqxp'
        var reqfxp = %var.player/tlevel%
        var reqfxp += 2
        var reqfxp' = %var.player/tlevel%
        var reqfxp' += 1
        var reqfxp *= %var.player/reqfxp'%
        var reqfxp *= %var.player/tlevel%
        var reqfxp *= 25
        var reqfxp /= 3
        var reqmxp = %var.player/tlevel%
        var reqmxp += 2
        var reqmxp' = %var.player/tlevel%
        var reqmxp' += 1
        var reqmxp *= %var.player/reqmxp'%
        var reqmxp *= %var.player/tlevel%
        var reqmxp *= 25
        var reqmxp /= 3
    }
    pause 1
    if (var xp >= %var.player/reqxp%) {
        var xp -= %var.player/reqxp%
        var prelevel = %var.player/level%
        var level += 1
        sound "Level Up" 0.7 1.0 "Invokers Location"
        pause 5
        chat "&3&l&m---------------------------------------------"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &6&lG&e&lG&f! &fYou are &eLeveling up!"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &8[&7%var.player/prelevel%&8] &f&l>>> &l&l&3[&b%var.player/level%&3]"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &b&n&l%var.player/reqxp%&b&nxp&f to the &3Next Level."
        chat "&3&l&m---------------------------------------------."
        var prelevel unset
    }
    if (var fxp >= %var.player/reqfxp%) {
        var fxp -= %var.player/reqfxp%
        var pretlevel = %var.player/tlevel%
        var tlevel += 1
        sound "Level Up" 0.7 1.0 "Invokers Location"
        pause 5
        chat "&3&l&m---------------------------------------------"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &6&lG&e&lG&f! &fYou are &eLeveling up!"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &8[&7%var.player/pretlevel%&8] &f&l>>> &l&l&3[&b%var.player/tlevel%&3]"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &b&n&l%var.player/reqfxp%&b&nxp&f to the &3Next Level."
        chat "&3&l&m---------------------------------------------"
        var pretlevel unset
    }
    if (var mxp >= %var.player/reqmxp%) {
        var mxp -= %var.player/reqmxp%
        var pretlevel = %var.player/tlevel%
        var tlevel += 1
        sound "Level Up" 0.7 1.0 "Invokers Location"
        pause 5
        chat "&3&l&m---------------------------------------------"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &6&lG&e&lG&f! &fYou are &eLeveling up!"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &8[&7%var.player/premlevel%&8] &f&l>>> &l&l&3[&b%var.player/mlevel%&3]"
        chat "&a"
        chat "&a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &a &b&n&l%var.player/reqmxp%&b&nxp&f to the &3Next Level."
        chat "&3&l&m---------------------------------------------"
        var premlevel unset
    }

goto function "Global Loop"
    globalvar looptimes += 1
    if (globalvar looptimes >= %house.players% 0) {
        globalvar looptimes = 0
    } else {
        exit
    }
    globalvar uptime_t += 5
    function "Event Main"

goto function "Event Start"
    globalvar eventcd_t -= 5D
    if (globalvar eventcd_t <= 0D 0) {
        globalvar eventcd_t = 36000D
        globalvar eventcd_s = %var.player/eventcd_t%
        globalvar eventcd_s /= 20D
        globalvar eventcd_s = %var.player/eventcd_s%L
        globalvar eventid = %random.int/1 %
    } else {
        exit
    }
    if (globalvar eventid = 1 0) {
        chat "&b❃ &lEXP WIND! &7It gives you &b+50% ✧ Exp&7! &a(5:00)"
        sound "Ambience Rain" 1.0 0.1 "Invokers Location"
        sound "Bat Loop" 1.0 0.8 "Invokers Location"    
    }
    if (globalvar eventid = 2 0) {
        chat "&a❃ &lGATHERING FRENZY!&7 &dx1.5&7 chance to get rare items from gathering! &a(5:00)"
    }
    if (globalvar eventid = 3 0) {
        chat "&e⛃ &lGOLD RUSH! &7Enemies now give you &e+50% ⛃ Gold&7! &a(5:00)"
    }
    if (globalvar eventid = 4 0) {
        chat "&6❃ &lAUCTION! &7A &ospecial &7item has been offered on auction!"
        sound "Enderdragon Growl" 0.7 1.0 "Invokers Location"
        var ahtime = 180
        function "Auction Start"
    }

goto function "Auction Start"
    globalvar ahid = %random.int/1 %
    if (var ahid = 1) {
        chat "&6➲ &7Offer: &aPiggy Bank &7Starts at: &e1000⛃"
        globalvar bprice = 1000
        globalvar bids = 0
        globalvar ahitem = &aPiggy Bank
    }
    chat "&6➲ &7The auction lasts in &a3min&7! &e/bid&7 to bid"

goto function "During Event"
    if (globalvar eventid = 1 0, var eventcd_t > 30000D) {
        var mobxpmulti += 50
    }
    if (globalvar eventid = 2 0, var eventcd_t > 30000D) {
        var woodmfmulti += 50
        var minemfmulti += 50
    }
    if (globalvar eventid = 3 0, var eventcd_t > 30000D) {
        var mobgoldmulti += 50
    }
    if (globalvar eventid = 4 0, var ahtime >= 1 0) {
        var ahtime -= 1
    }

goto function "Event End"
    if (globalvar eventid = 1 0, var eventcd_t <= 30000D) {
        globalvar eventid unset
        chat "&8❃ &lEXP WIND ENDED! &7The exp boost has expired!"
    }
    if (globalvar eventid = 2 0, var eventcd_t <= 30000D) {
        globalvar eventid unset
        chat ""
    }
    if (globalvar eventid = 3 0, var eventcd_t <= 30000D) {
        globalvar eventid unset
        chat "&8❃ &lGATHERING FRENZY ENDED!&7 Put your tool down and take a break!"
    }
    if (globalvar eventid = 4 0, var ahtime <= 0) {
        globalvar eventid unset
        globalvar ahtime unset
        chat "&8❃ &lAUCTION ENDED! &a%var.player/winner%&7 has won &a%var.global/ahitem%&7 for &e%var.global/highestbid%⛃&7!"
        function "Auction End"
    }

goto function "Auction End"
    if (!globalvar winner = %player.name%) {
        exit
    }
    if (globalvar ahid = 1 0) {
        giveItem slot_1 true
    }
    globalvar winner unset
    globalvar ahitem unset
    globalvar ahp1 unset
    globalvar ahp2 unset
    globalvar ahp3 unset
    globalvar totalbids unset
    globalvar bids unset

goto command "/bid"
    if (!globalvar eventid = 4 0) {
        sound "Anvil Land" 0.7 1.0 "Invokers Location"
        chat "&7[&c!&7] &c&lERROR! &cThe auction event is not ongoing now!"
        exit
    }
    displayMenu "Bid Menu"

goto function "Auction Price"
    if () {
        globalvar ahp1 = globalvar bids
        globalvar ahp1 += 3
        globalvar ahp1' = globalvar bids
        globalvar ahp1' += 2
        globalvar ahp1'' = globalvar bids
        globalvar ahp1'' += 1
        globalvar ahp1 *= globalvar ahp1'
        globalvar ahp1 *= globalvar ahp1''
        globalvar ahp1 *= globalvar bids
        globalvar ahp1' unset
        globalvar ahp1'' unset
    }
    if () {
        globalvar ahp2 = globalvar bids
        globalvar ahp2 += 7
        globalvar ahp2' = globalvar bids
        globalvar ahp2' += 6
        globalvar ahp2'' = globalvar bids
        globalvar ahp2'' += 5
        globalvar ahp2''' = globalvar bids
        globalvar ahp2''' += 4
        globalvar ahp2 *= globalvar ahp2'
        globalvar ahp2 *= globalvar ahp2''
        globalvar ahp2 *= globalvar ahp2'''
        globalvar ahp2' unset
        globalvar ahp2'' unset
        globalvar ahp2''' unset
    }
    if () {
        globalvar ahp3 = globalvar bids
        globalvar ahp3 += 22
        globalvar ahp3' = globalvar bids
        globalvar ahp3' += 21
        globalvar ahp3'' = globalvar bids
        globalvar ahp3'' += 20
        globalvar ahp3''' = globalvar bids
        globalvar ahp3''' += 19
        globalvar ahp3 *= globalvar ahp3'
        globalvar ahp3 *= globalvar ahp3''
        globalvar ahp3 *= globalvar ahp3'''
        globalvar ahp3' unset
        globalvar ahp3'' unset
        globalvar ahp3''' unset
    }

//Bids Option 1
    if (globalvar eventid = 4 0) {
        chat "&7[&c!&7] &c&lERROR! &cThe auction event is not ongoing now!"
        sound "Anvil Land" 0.7 1.0 "Invokers Location"
        exit
    }
    if (globalvar winner = %player.name% 0) {
        chat "&7[&c!&7] &c&lERROR! &cYou are already highest bidder!"
        sound "Anvil Land" 0.7 1.0 "Invokers Location"
        exit
    }
    if (var gold >= globalvar ahp1) {
        var gold -= globalvar ahp1
        globalvar bids += 1
        globalvar totalbids += 1
        globalvar winner = %player.name%
        sound "Orb Pickup" 0.7 1.0 "Invokers Location"
    } else {
        chat "&7[&c!&7] &c&lERROR! &cYou don't have enough gold to bid!"
        sound "Anvil Land" 0.7 1.0 "Invokers Location"
        exit
    }
    if (globalvar ahtime <= 15) {
        globalvar ahtime += 15
        chat "&6➲ &a%var.global/winner% &7has placed a bid of &e%var.global/ahp1%⛃&7! &8( &a%var.global/ahtime%s &7left &8)"
        chat "&6➲ &7A final-moment bid was placed! Auction time extended by &a+15s&7!"
    } else {
        chat "&6➲ &a%var.global/winner% &7has placed a bid of &e%var.global/ahp1%⛃&7! &8( &a%var.global/ahtime%s &7left &8)"
    }
    function "Auction Price"
    displayMenu "Bid Menu"

