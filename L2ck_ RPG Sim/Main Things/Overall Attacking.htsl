goto function "Globalboss Ranking"
    if (var gmob/tdmg > globalvar gmob/rank1/tdmg) {
        globalvar gmob/rank1 = %player.name%
        globalvar gmob/rank1/tdmg = var tdmg
        var gdroptimes = 5
    }
    pause 1
    if (!globalvar gmob/rank1 = %player.name%, var gmob/tdmg > globalvar gmob/rank2/tdmg) {
        globalvar gmob/rank2 = %player.name%
        globalvar gmob/rank2/tdmg = var tdmg
        var gdroptimes = 3
    }
    pause 1
    if (!globalvar gmob/rank1 = %player.name%, !globalvar gmob/rank2 = %player.name%, var gmob/tdmg > globalvar gmob/rank3/tdmg) {
        globalvar gmob/rank3 = %player.name%
        globalvar gmob/rank3/tdmg = var tdmg
        var gdroptiems = 2
    }
    
goto function "Globalboss Defeat"
    if (globalvar gmobid = 1, var gmobid = 1) {
        function "Globalboss Ranking"
        function "Globalboss Reward"
    }
    if (globalvar gmobid = 1) {
        sound "Wither Death" 0.7 1.0 "Invokers Location"
        chat "&4&m&l----------------------------------------"
        chat "&4&l[Global Boss] &e&lSandworm &chas defeated..."
        chat "&7Best Damage Player:"
        chat "&7 &e#1 &a%var.global/gmob/rank1%&f: &c%var.global/gmob/rank1/tdmg% &c☠ Damage"
        chat "&7 &7#2 &a%var.global/gmob/rank2%&f: &c%var.global/gmob/rank2/tdmg% &c☠ Damage"
        chat "&7 &6#3 &a%var.global/gmob/rank3%&f: &c%var.global/gmob/rank3/tdmg% &c☠ Damage"
        chat "&4&m&l----------------------------------------"
        pause 50
        var gmob/tdmg unset
        globalvar gmob/rank1 unset
        globalvar gmob/rank2 unset
        globalvar gmob/rank3 unset
        globalvar gmob/rank1/tdmg unset
        globalvar gmob/rank2/tdmg unset
        globalvar gmob/rank3/tdmg unset
        globalvar gmobid unset
    }

goto function "Globalboss Reward"
    if (var gdroptimes >= 1) {
        var gdroptimes -= 1
    } else {
        var gmobid unset
        var gdroptimes unset
        exit
    }
    if (var gmobid = 1) {
        giveItem slot_1 true 
        giveItem slot_2 true
        timer add += 1
        
    }

    
    