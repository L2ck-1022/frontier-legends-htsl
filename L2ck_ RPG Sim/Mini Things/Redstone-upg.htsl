}
if (var rshpcost = 0 0, var rshplv = 0 0) {
    var rshpcost = "&fRaw Redstone &7x1"
}
if (inRegion "Redstone Upgrade") {
    var rseff = var rsefflv
    var rsminemf = var rsminemflv
    var rshp = var rshplv
    var rseff *= 2
    var rsminemf *= 2
    var rshp *= 2
    var rseff' = var rseff
    var rsminemf' = var rsminemf
    var rshp' = var rshp
    var rseff' += 2
    var rsminemf' += 2
    var rshp' += 2
}
if (var rsefflv >= 20) {
    var rseff' unset
}
if (var rsminemflv >= 20) {
    var rsminemf' unset
}
if (var rshplv >= 10) {
    var rshp' unset
}


